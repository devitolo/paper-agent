# Supply a reviewed immutable AMD64 base digest when publishing a release.
ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}
RUN addgroup --system --gid 10002 publisher \
 && adduser --system --uid 10002 --ingroup publisher publisher
WORKDIR /opt/project-paper-observability-publisher
COPY paper_agents/__init__.py paper_agents/observability_transport.py paper_agents/observability_publisher.py ./paper_agents/
USER 10002:10002
ENTRYPOINT ["python3", "-m", "paper_agents.observability_publisher"]
