# Installer records these selections; no provider credentials are required.
# No Project Paper release image is published yet. Use --build for a local image.
PAPER_APP_IMAGE=project-paper:local-m1
# Required: explicitly select the Ollama image. Releases must pin its tested digest.
PAPER_OLLAMA_IMAGE=
PAPER_PORT=8000
PAPER_MODEL_PREPARE_TIMEOUT=1800
PAPER_MODEL_PULL_ATTEMPTS=2
PAPER_MODEL_CHECK_TIMEOUT=120
# Provisional preflight values, not qualified minimum hardware requirements.
PAPER_MIN_MEMORY_MB=4096
PAPER_MIN_DISK_MB=6144
