# LOCAL MIGRATION CANDIDATE: fill private inputs and qualify before deployment.
# App image must be built with Dockerfile target=migration-gemini; digest remains unqualified.
PAPER_AGENT_PACKAGED=1
PAPER_AGENT_STARTUP_MODE=imported
PAPER_AGENT_IMPORT_MANIFEST=/import/manifest.json
PAPER_AGENT_DEFAULT_SOURCES=arxiv,semantic_scholar,openalex
PAPER_AGENT_MODEL=qwen2.5:1.5b-instruct
PAPER_MODEL_MODE=verify
PAPER_MODEL_VERIFY_TIMEOUT=30
PAPER_AGENT_EXPECTED_MODEL_DIGEST=65ec06548149b04c096a120e4a6da9d4017ea809c91734ea5631e89f96ddc57b
# Deliberately unresolved: 0 or 1 must be selected explicitly after inventory/rehearsal.
# Missing Gemini runtime/key/model policy disables profile application, not saved browsing.
PAPER_AGENT_GEMINI_ENABLED=
PAPER_AGENT_TELEMETRY=
# Explicit validated http(s) /v1/traces endpoint required when telemetry=1.
PAPER_AGENT_OTLP_ENDPOINT=

# Standalone Compose contract; deployment identifiers remain deliberately unresolved.
PAPER_MIGRATION_PROJECT=
PAPER_MIGRATION_APP_IMAGE=
PAPER_MIGRATION_OLLAMA_IMAGE=
PAPER_MIGRATION_PORT=
PAPER_IMPORT_MANIFEST_FILE=
PAPER_PHOENIX_DNS=
PAPER_MIGRATION_DATA_VOLUME=
PAPER_MIGRATION_CONFIG_VOLUME=
PAPER_MIGRATION_CONTROL_VOLUME=
PAPER_MIGRATION_LOG_VOLUME=
PAPER_MIGRATION_BACKUP_VOLUME=
PAPER_MIGRATION_MODEL_VOLUME=
PAPER_AGENT_LIFECYCLE_DIR=/runtime-control
# Parked custom scheduler: first cutover retains host cron.
PAPER_AGENT_SCHEDULER_ENABLED=0
PAPER_AGENT_JOB_TIMEOUT=1800
PAPER_AGENT_JOB_STOP_GRACE=8
# SEMANTIC_SCHOLAR_API_KEY is provisioned in the private env file.

# Private host file, owned by UID10001, mode0400/0600. Never paste key contents here.
PAPER_GEMINI_KEY_FILE=
# Explicit approved CLI default; unresolved. Does not change application model=None.
PAPER_AGENT_GEMINI_DEFAULT_MODEL=

# ONLY with explicit docker-compose.mini-rehearsal.yml overlay and inspected receipt.
# In that route, image values above are full sha256:<config-ID>, never fake registry digests.
PAPER_REHEARSAL_SOURCE_SHA256=
PAPER_REHEARSAL_IDENTITY_FILE=
