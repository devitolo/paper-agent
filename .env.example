# Installer records these selections; no provider credentials are required.
# v0.1.0 is a release candidate, not a published or qualified release. A published
# installation should replace both values with tested immutable index digests.
PAPER_APP_IMAGE=ghcr.io/devitolo/paper-agent:v0.1.0
# v0.1.0 candidate: inspected 2026-09-10 as a multi-platform OCI index. It is
# not accepted for release until live macOS arm64 and Linux amd64 QA succeeds.
PAPER_OLLAMA_IMAGE=docker.io/ollama/ollama@sha256:684d8674b4315fa18f4f0e973a118ec2652ed96f67563277839985175858e0ba
PAPER_PORT=8000
PAPER_MODEL_PREPARE_TIMEOUT=1800
PAPER_MODEL_PULL_ATTEMPTS=2
PAPER_MODEL_CHECK_TIMEOUT=120
# Provisional preflight values, not qualified minimum hardware requirements.
PAPER_MIN_MEMORY_MB=4096
PAPER_MIN_DISK_MB=6144
