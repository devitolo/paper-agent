# BEGIN PROJECT PAPER MANAGED JOBS

SHELL=/bin/bash
PAPER_MIGRATION_ENV_FILE=$HOME/paper-mini-rehearsal/production-cutover/final-20260924-230636/production.env
PAPER_MIGRATION_EXTRA_COMPOSE_FILES=$HOME/paper-mini-rehearsal/production-cutover/docker-compose.production.yml
PAPER_MIGRATION_DEPLOY_LOCK_FILE=$HOME/paper-mini-rehearsal/production-cutover/deploy.lock

# Installed by scripts/install_project_paper_cron.sh.

# Keep edits in this repo file so explicit deployment updates carry schedule changes.

# Containerized Project Paper jobs. Host cron owns the schedule; the launcher
# enters the existing production app container. Do not replace these with
# native host-runtime jobs while the Mini container runtime is authoritative.

0 4 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh openalex >> logs/pipeline-openalex.log 2>&1

# Paused afternoon: 0 16 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh openalex >> logs/pipeline-openalex.log 2>&1

0 5 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh arxiv >> logs/pipeline-daily.log 2>&1

# Paused afternoon: 0 17 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh arxiv >> logs/pipeline-daily.log 2>&1

0 6 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh semantic >> logs/pipeline-semantic-scholar.log 2>&1

# Paused afternoon: 0 18 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh semantic >> logs/pipeline-semantic-scholar.log 2>&1

0 2 * * 1 cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh profile >> logs/profile-rebuild-compare.log 2>&1

0 1 * * 0 cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh backup >> logs/backup-db.log 2>&1

# END PROJECT PAPER MANAGED JOBS
