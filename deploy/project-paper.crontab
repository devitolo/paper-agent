# BEGIN PROJECT PAPER MANAGED JOBS

SHELL=/bin/bash
PAPER_MIGRATION_ENV_FILE=/home/devitolo/paper-mini-rehearsal/production-cutover/final-20260924-230636/production.env
PAPER_MIGRATION_EXTRA_COMPOSE_FILES=/home/devitolo/paper-mini-rehearsal/production-cutover/docker-compose.production.yml
PAPER_MIGRATION_DEPLOY_LOCK_FILE=/home/devitolo/paper-mini-rehearsal/production-cutover/deploy.lock
PAPER_MINILM_EVAL_ENABLED=0
PAPER_MINILM_SHADOW_ENABLED=0
PAPER_AGENT_SYNC_ENABLED=1
PAPER_AGENT_SYNC_EXPLICIT_PRODUCTION=1
PAPER_AGENT_SYNC_AWS_URL=https://paper-prod.tail5fc461.ts.net
PAPER_AGENT_SYNC_PRODUCER=mini-production
PAPER_AGENT_SYNC_ENVIRONMENT=production
# Controlled routine JSON/gzip exchange activation after the disabled-default
# image preflight. The wrapper still owns source pull/process/push sequencing.
PAPER_AGENT_ROUTINE_SYNC=1

# Installed by scripts/install_project_paper_cron.sh.

# Keep edits in this repo file so explicit deployment updates carry schedule changes.

# Containerized Project Paper jobs. Host cron owns the schedule; the launcher
# enters the existing production app container. Do not replace these with
# native host-runtime jobs while the Mini container runtime is authoritative.

# Staggered source jobs. Each source pulls current AWS state before running
# and publishes its results afterward.
0 6 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh core >> logs/pipeline-core.log 2>&1
0 4 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh openalex >> logs/pipeline-openalex.log 2>&1
0 5 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh arxiv >> logs/pipeline-arxiv.log 2>&1
0 3 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh semantic >> logs/pipeline-semantic-scholar.log 2>&1

# Paused afternoon runs retained for reference:
# 0 16 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh openalex >> logs/pipeline-openalex.log 2>&1
# 0 17 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh arxiv >> logs/pipeline-arxiv.log 2>&1
# 0 18 * * * cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh semantic >> logs/pipeline-semantic-scholar.log 2>&1

# Weekly Industry / ZenML discovery. Uses separate config and no academic MiniLM ranking.
30 23 * * 0 cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh zenml >> logs/pipeline-zenml.log 2>&1

# Weekly profile rebuild.
0 2 * * 1 cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh profile >> logs/profile-rebuild-compare.log 2>&1

# Weekly database backup.
0 1 * * 0 cd "$HOME/paper-mini-rehearsal/candidate" && mkdir -p logs && bash scripts/mini_container_job.sh backup >> logs/backup-db.log 2>&1

# END PROJECT PAPER MANAGED JOBS
