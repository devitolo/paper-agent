# Mini non-production only. Install as root-owned /etc/project-paper-observability/mini-nonprod.env.
PROJECT_PAPER_RESOURCE_ROOT=/var/lib/project-paper-observability/mini-nonprod
PROJECT_PAPER_RESOURCE_HOST=clarkmini
PROJECT_PAPER_RESOURCE_ENVIRONMENT=mini-nonprod
# Fixed allowlist; leave empty to omit Docker observations.
PROJECT_PAPER_CONTAINER_NAMES=paper-mini-nonprod-app-1,paper-mini-nonprod-pipeline-pipeline-1
